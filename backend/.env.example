# Firebase 설정
# Firebase 콘솔에서 다운로드한 서비스 계정 키 파일의 경로를 지정하세요
# 예: config/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json

# OpenAI API 설정 (현재 사용하지 않음)
# OPENAI_API_KEY=your_openai_api_key_here

# 스케줄러 설정
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
SCRAPE_KEYWORDS=소프트웨어,개발,IT

# Flask 설정
PORT=5000
