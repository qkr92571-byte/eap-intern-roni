# ─────────────────────────────────────────────────
# EAP 인턴로니 환경변수 설정 파일
# 이 파일을 복사하여 .env 로 저장한 후 값을 채워주세요.
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)
# ─────────────────────────────────────────────────

# [필수] Firebase 서비스 계정 키 파일 경로
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# Windows 예시: C:\Users\홍길동\Documents\firebase-credentials.json
# Mac 예시: /Users/홍길동/Documents/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=

# [필수] OpenAI API 키 (GPT 검수에 사용)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [필수] Slack 봇 토큰 (리포트 전송에 사용)
# Slack 앱 설정 → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=

# [고정] Slack 공식 채널 ID (변경 금지)
SLACK_CHANNEL_ID=C034EQD6W4W

# [고정] Slack EAP 파트 유저그룹 ID (변경 금지)
SLACK_EAP_USERGROUP=S08SE5ZTPQD

# [고정] 프론트엔드 URL (변경 금지)
FRONTEND_URL=https://eap-intern-roni.web.app

# [선택] Flask 포트 (기본값: 5000)
PORT=5000
